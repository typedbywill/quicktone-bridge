{
  "name": "quicktone-bridge",
  "version": "1.0.0",
  "description": "CLI tool and TypeScript library for NUX MG-30 Multi-Effects Processor",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "nux": "./dist/cli.js",
    "quicktone-bridge": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:guided": "tsx scripts/guided-test.ts",
    "capture-dump": "tsx scripts/capture-dump.ts",
    "nux": "tsx src/cli/index.ts",
    "start": "node dist/cli.js",
    "install:cli": "npm run build && npm install -g .",
    "uninstall:cli": "npm uninstall -g quicktone-bridge",
    "link": "npm run build && npm link",
    "unlink": "npm unlink"
  },
  "keywords": [
    "nux",
    "mg30",
    "mg-30",
    "quicktone",
    "cli",
    "nux-cli",
    "midi",
    "sysex",
    "guitar-effects"
  ],
  "author": "William",
  "license": "MIT",
  "dependencies": {
    "@julusian/midi": "^3.8.0",
    "commander": "^14.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
